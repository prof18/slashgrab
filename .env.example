APP_NAME=Slashgrab
PRODUCT_NAME=Slashgrab
BUNDLE_ID=com.prof18.slashgrab
MACOS_MIN_VERSION=13.0
SIGNING_MODE=adhoc
APP_IDENTITY=
# Used by Scripts/build_and_run.sh so macOS exposes the Finder extension.
# When empty, the script auto-selects only when exactly one Apple Development identity exists.
# Set APPLE_ID or DEV_APP_IDENTITY to disambiguate multiple identities.
DEV_APP_IDENTITY=""
# The signed dev app is installed here before launch.
DEV_INSTALL_DIR=$HOME/Applications
APPLE_ID=
TEAM_ID=
# Optional production override. Use <signing team>.<group name>; group.* requires a
# provisioning profile and is rejected by this profile-free manual signing flow.
APP_GROUP_ID=
# Optional dev-only team-prefixed override. Dev builds never inherit APP_GROUP_ID.
DEV_APP_GROUP_ID=
KEYCHAIN_PROFILE=
SPARKLE_PRIVATE_KEY_FILE=
# Required for production packaging.
SPARKLE_PUBLIC_ED_KEY=
# Production-only; dev builds discard all Sparkle feed and key configuration.
SPARKLE_FEED_URL=https://raw.githubusercontent.com/prof18/slashgrab/main/appcast.xml
# Optional. By default Scripts/make_appcast.sh uses:
# https://github.com/prof18/slashgrab/releases/download/v<version>/
SPARKLE_DOWNLOAD_URL_PREFIX=
# Production setting. Dev builds disable the updater entirely.
ENABLE_SPARKLE_AUTOMATIC_CHECKS=true
